FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-value
LOG_LEVEL=INFO
TOTAL_BANDWIDTH_MBPS=100
SIMULATION_ENABLED=true

# Windows Mobile Hotspot settings
HOTSPOT_INTERFACE=Local Area Connection* 4
HOTSPOT_GATEWAY=192.168.137.1

# Packet capture (Npcap required for live Scapy capture on Windows)
# Set to live to start in live mode; otherwise choose Simulation in dashboard.
CAPTURE_MODE=simulation
CAPTURE_INTERFACE=Wi-Fi
CAPTURE_BACKEND=scapy
TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe

# QoS enforcement is intentionally disabled by default.
# Linux only: enabling applies an interface-wide HTB cap, not per-app PQ/WFQ.
QOS_ENFORCEMENT_ENABLED=false
QOS_INTERFACE=
